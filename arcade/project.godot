; ゲームセンターシミュレーター本体。
; 物理設定は phase0-pusher で実測して合格した値をそのまま持ち込んでいる。
; ここを触ると Phase 0 の検証結果が無効になるので、変えるときは再検証すること。

config_version=5

[application]

config/name="Arcade"
config/description="メダルコーナーのシミュレーター"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

; --- スケールに合わせた重力(設計書 4.1 からの意図的な逸脱) ---
; 剛体系は「長さ k 倍・重力 a 倍」で時間が √(k/a) 倍にスケールする。
; 10 倍スケールで 9.8 のままだと時間が √10 ≒ 3.16 倍に伸び、実物の 1/3 の速さで落ちる。
; a = k = 10 にして初めて sim 秒 = 実秒 になり、落下も山の崩れも実物の速さで見える。
; 設計書は「重力を変えると嘘くさくなる」と書いているが、スケール倍率に合わせる場合は逆。
; 詳細な導出は src/core/medal/medal_spec.gd の冒頭。
3d/default_gravity=98.0

; --- 設計書 4.3 + Phase 0 の実測補正 ---
; 重力を 10 倍にしたぶん速度も √10 倍になるので、時間解像度を 120 → 180Hz に上げる。
common/physics_ticks_per_second=180
common/max_physics_steps_per_frame=8
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=10
jolt_physics_3d/simulation/position_steps=2
jolt_physics_3d/simulation/baumgarte_stabilization_factor=0.2
jolt_physics_3d/simulation/allow_sleep=true
; 既定の penetration_slop=0.02 はコリジョン厚 0.024 とほぼ同じで、
; メダル同士がほぼ 1 枚分めり込むのを許してしまう。桁を下げる。
jolt_physics_3d/simulation/penetration_slop=0.002
; 速度が上がったぶん、すり抜けかけの接触を拾う距離も広げる。
; 既定の 0.02 はメダル厚 0.036 に近すぎて離れた位置で止まる。
jolt_physics_3d/simulation/speculative_contact_distance=0.008
; 凸包マージンの既定 8% はメダル厚に対して大きすぎ、角が丸まって滑る。
jolt_physics_3d/collisions/collision_margin_fraction=0.02

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[editor_plugins]

; gdUnit4。テストは CLI(check.cmd)でもエディタのパネルからでも回せる。
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
